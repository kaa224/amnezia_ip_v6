# Install as /etc/systemd/system/awg31@relay.service.d/override.conf
[Service]
ExecStart=
ExecStart=/opt/awg31/bin/amneziawg-go -f awg31r
ExecStartPost=
ExecStartPost=/bin/sh -c 'n=0; while [ ! -S /run/personal-awg31/amneziawg/awg31r.sock ]; do n=$$((n+1)); [ "$$n" -lt 100 ] || exit 1; sleep 0.1; done; exec /opt/awg31/bin/awg setconf awg31r /etc/awg31/relay.conf'
ExecStartPost=/usr/sbin/ip address add 203.0.113.65/26 dev awg31r
ExecStartPost=/usr/sbin/ip -6 address add 2001:db8:31:2::1/64 dev awg31r
ExecStartPost=/usr/sbin/ip link set dev awg31r mtu 1280 up
