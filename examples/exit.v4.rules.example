# MANUAL ONLY: after review, --test --noflush, then --noflush. Never plain restore.
*filter
-N PV31D_P
-N PV31D_H
-N PV31D_O
-N PV31D_I
-N PV31R_P
-N PV31R_H
-N PV31R_O
-N PV31R_I
-A PV31D_P -d 192.0.2.10/32 -j ACCEPT
-A PV31D_P -j DROP
# OPTIONAL: -A PV31D_H -i awg31d -s 203.0.113.0/26 -d 192.0.2.10/32 -p tcp --dport 443 -j ACCEPT
-A PV31D_H -j DROP
-A PV31D_O -d 0.0.0.0/8 -j DROP
-A PV31D_O -d 10.0.0.0/8 -j DROP
-A PV31D_O -d 100.64.0.0/10 -j DROP
-A PV31D_O -d 127.0.0.0/8 -j DROP
-A PV31D_O -d 169.254.0.0/16 -j DROP
-A PV31D_O -d 172.16.0.0/12 -j DROP
-A PV31D_O -d 192.0.0.0/24 -j DROP
-A PV31D_O -d 192.0.2.0/24 -j DROP
-A PV31D_O -d 192.168.0.0/16 -j DROP
-A PV31D_O -d 198.18.0.0/15 -j DROP
-A PV31D_O -d 198.51.100.0/24 -j DROP
-A PV31D_O -d 203.0.113.0/24 -j DROP
-A PV31D_O -d 224.0.0.0/4 -j DROP
-A PV31D_O -d 240.0.0.0/4 -j DROP
-A PV31D_O -s 203.0.113.0/26 -o REPLACE_WAN_IF -j ACCEPT
-A PV31D_O -j DROP
-A PV31D_I -d 203.0.113.0/26 -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
-A PV31D_I -j DROP
-I INPUT 1 -p udp --dport 52010 -j PV31D_P
-I FORWARD 1 -i awg31d -j PV31D_O
-I FORWARD 1 -o awg31d -j PV31D_I
-A PV31R_P -j DROP
# OPTIONAL: -A PV31R_H -i awg31r -s 203.0.113.64/26 -d 192.0.2.10/32 -p tcp --dport 443 -j ACCEPT
-A PV31R_H -j DROP
-A PV31R_O -d 0.0.0.0/8 -j DROP
-A PV31R_O -d 10.0.0.0/8 -j DROP
-A PV31R_O -d 100.64.0.0/10 -j DROP
-A PV31R_O -d 127.0.0.0/8 -j DROP
-A PV31R_O -d 169.254.0.0/16 -j DROP
-A PV31R_O -d 172.16.0.0/12 -j DROP
-A PV31R_O -d 192.0.0.0/24 -j DROP
-A PV31R_O -d 192.0.2.0/24 -j DROP
-A PV31R_O -d 192.168.0.0/16 -j DROP
-A PV31R_O -d 198.18.0.0/15 -j DROP
-A PV31R_O -d 198.51.100.0/24 -j DROP
-A PV31R_O -d 203.0.113.0/24 -j DROP
-A PV31R_O -d 224.0.0.0/4 -j DROP
-A PV31R_O -d 240.0.0.0/4 -j DROP
-A PV31R_O -s 203.0.113.64/26 -o REPLACE_WAN_IF -j ACCEPT
-A PV31R_O -j DROP
-A PV31R_I -d 203.0.113.64/26 -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
-A PV31R_I -j DROP
-I INPUT 1 -p udp --dport 52011 -j PV31R_P
-I FORWARD 1 -i awg31r -j PV31R_O
-I FORWARD 1 -o awg31r -j PV31R_I
-I INPUT 1 -i awg31d -j PV31D_H
-I INPUT 1 -i awg31r -j PV31R_H
COMMIT
*nat
-N PV31D_N
-N PV31R_N
-A PV31D_N -j MASQUERADE
-A PV31R_N -j MASQUERADE
-I POSTROUTING 1 -s 203.0.113.0/26 -o REPLACE_WAN_IF -j PV31D_N
-I POSTROUTING 1 -s 203.0.113.64/26 -o REPLACE_WAN_IF -j PV31R_N
COMMIT
